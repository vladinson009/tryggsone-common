{
  "name": "@tryggsone/common",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.0.23",
  "repository": {
    "type": "git",
    "url": "https://github.com/vladinson009/tryggsone-common.git"
  },
  "description": "Reusable RabbitMQ connection, publisher, and listener classes for microservices. Custom error classes. DB types",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "patch": "npm version patch",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "exports": {
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    },
    "./keys": {
      "types": "./dist/keys/index.d.ts",
      "default": "./dist/keys/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./configs": {
      "types": "./dist/configs/index.d.ts",
      "default": "./dist/configs/index.js"
    },
    "./libs": {
      "types": "./dist/libs/index.d.ts",
      "default": "./dist/libs/index.js"
    }
  },
  "peerDependencies": {
    "amqplib": "^2.0.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
